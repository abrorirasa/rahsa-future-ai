# Salin file ini menjadi ".env" dan isi dengan nilai asli.
# JANGAN PERNAH commit file ".env" ke git atau bagikan ke siapapun.

# ==== Application ====
APP_ENV=development
LOG_LEVEL=INFO

# ==== PostgreSQL ====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rahsa_future_ai
POSTGRES_USER=rahsa_user
POSTGRES_PASSWORD=change_me

# ==== MongoDB ====
MONGO_URI=mongodb://localhost:27017
MONGO_DB=rahsa_future_ai_market

# ==== Binance API (KOSONGKAN sampai siap paper trading) ====
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ==== Risk Management defaults (sesuai Implementation Decision Notes) ====
MAX_SIMULTANEOUS_POSITIONS=3
MAX_RISK_PER_POSITION_PERCENT=2
